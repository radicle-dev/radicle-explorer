#!/usr/bin/env bash
set -Eeou pipefail

version="$(node -e 'console.log(require("twemoji/package.json").version)')"
stamp="public/twemoji/.version"

# The assets are 17MB. Both `npm ci` and `npm run build` call this script, so
# skip the download when the installed version is already extracted.
if [ "$(cat "$stamp" 2>/dev/null)" = "$version" ]; then
  echo "Twemoji SVG assets v${version} are present, skipping download"
  exit 0
fi

echo "Installing Twemoji SVG assets v${version}"

curl -sSL "https://github.com/twitter/twemoji/archive/refs/tags/v${version}.tar.gz" \
  | tar -x -z -C public/twemoji/ --strip-components=3 "twemoji-${version}/assets/svg"

echo "$version" >"$stamp"
