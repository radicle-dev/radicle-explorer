{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "es2023",
    "types": ["vite/client"],
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  }
}
